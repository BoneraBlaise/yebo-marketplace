# Development server — accessible on local network (phone testing)
HOST=0.0.0.0
WDS_SOCKET_HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Dev proxy target (used by src/setupProxy.js) — localhost-first
REACT_APP_PROXY_TARGET=http://localhost:5000
REACT_APP_APP_URL=http://localhost:3000
REACT_APP_SOCKET_URL=http://localhost:4000

# Override package.json homepage for local dev. Must be "/" (truthy) — empty PUBLIC_URL= is ignored by CRA.
PUBLIC_URL=/
