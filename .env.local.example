# =============================================================================
# Yebone Frontend — Local Development Environment
# Copy to `.env.development.local` (recommended) or merge into `.env.development`.
# Create React App loads `.env.development.local` automatically in dev mode.
#
# IMPORTANT — localhost-first policy:
# - Never set REACT_APP_API_URL here (development uses the dev-server proxy).
# - Never use onrender.com or github.io URLs in development.
# =============================================================================

# --- Local backend (dev proxy — no manual URL edits needed) ---
REACT_APP_PROXY_TARGET=http://localhost:5000

# Do NOT set REACT_APP_API_URL in development.
# src/config/serverConfig.js uses window.location.origin + /api/v2
# and src/setupProxy.js forwards /api/* to REACT_APP_PROXY_TARGET.

# --- Frontend origin (OAuth redirects, share links) ---
REACT_APP_APP_URL=http://localhost:3000

# --- CRA asset path (must be / for localhost:3000 — not /yebo-marketplace) ---
PUBLIC_URL=/

# --- Socket (optional — use local socket service if running) ---
REACT_APP_SOCKET_URL=http://localhost:4000

# --- Dev server (LAN testing on phone) ---
HOST=0.0.0.0
WDS_SOCKET_HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true

# =============================================================================
# Production-only variables (see .env.production — do not use locally)
# REACT_APP_API_URL=https://yebone-backend.onrender.com/api/v2
# =============================================================================

# --- Optional Supabase (reserved) ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
