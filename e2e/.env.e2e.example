# E2E credentials — copy to .env.e2e.local (gitignored) or configure in CI secrets.
# Never commit real passwords to the repository.

E2E_BACKEND_URL=http://127.0.0.1:5000
E2E_FRONTEND_URL=http://127.0.0.1:3000

# Vendor auth suites (08-vendor-auth-unified, pm-vendor-dashboard-visual-audit)
E2E_VENDOR_EMAIL=
E2E_VENDOR_PASSWORD=

# Communication journey suites (01–06)
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=

# Optional — pin a product for deterministic offer tests
# E2E_PRODUCT_ID=
