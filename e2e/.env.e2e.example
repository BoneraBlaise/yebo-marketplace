# E2E test credentials — copy to .env.e2e.local (gitignored) or CI secrets

E2E_BACKEND_URL=http://127.0.0.1:5000
E2E_FRONTEND_URL=http://127.0.0.1:3000

# Required for communication journey suites (1–6)
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=

# Optional — pin a product for deterministic offer tests
# E2E_PRODUCT_ID=
